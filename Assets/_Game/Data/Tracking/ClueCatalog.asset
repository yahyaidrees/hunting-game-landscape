%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 224071365528f38448c23ab27dc5f024, type: 3}
  m_Name: ClueCatalog
  m_EditorClassIdentifier: Game.Tracking::Game.Tracking.ClueCatalog
  entries:
  - kind: 0
    displayName: Footprint
    description: Count the toes and look for claw marks. Dog-family prints show claw
      tips; cat prints do not, because cats pull their claws in.
  - kind: 1
    displayName: Scat
    description: Droppings tell you what passed and what it ate. Fresh scat is dark
      and moist; old scat is dry and pale.
  - kind: 2
    displayName: Fur
    description: Hair snagged on grass or a bush shows the animal's size and the
      way it went.
  - kind: 3
    displayName: Claw marks
    description: Scratches on a tree mark territory. Their height shows how big the
      animal is.
  - kind: 4
    displayName: Drag marks
    description: 'A wide scuffed line: a predator carried its kill this way.'
  - kind: 5
    displayName: Kill site
    description: Predators come back to feed, often at dusk. Wait in cover downwind,
      or place a trail camera.
  - kind: 6
    displayName: Blood trail
    description: A wounded animal's path. Follow it before the animal recovers.
