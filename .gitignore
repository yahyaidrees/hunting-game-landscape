*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab

# Secrets: never commit
*.keystore
*.jks
*.p12
google-services.json
GoogleService-Info.plist
*.env
secrets/

# OS
.DS_Store
Thumbs.db
desktop.ini
