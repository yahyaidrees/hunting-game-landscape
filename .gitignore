# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# Staging and raw copies: large and not gate-checked, so kept local only.
# Commit an asset only after it passes the gate and moves into Assets/_Game or Assets/ThirdParty.
/[Aa]ssets/_Incoming/**
!/[Aa]ssets/_Incoming/OldGame/
!/[Aa]ssets/_Incoming/OldGame/README.md
!/[Aa]ssets/_Incoming/OldGame/README.md.meta
/SourceAssets/OldGame/**
!/SourceAssets/OldGame/README.md

# Addressables / asset pack build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/ServerData/

# IDE / generated project files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab

# Secrets: never commit
*.keystore
*.jks
*.p12
google-services.json
google-services.json.meta
GoogleService-Info.plist
# Firebase writes copies of the google-services.json keys into these (generated, never commit)
google-services-desktop.json
google-services-desktop.json.meta
google-services.xml
Assets/Plugins/Android/FirebaseApp.androidlib/
Assets/Plugins/Android/FirebaseApp.androidlib.meta
Assets/Plugins/Android/FirebaseCrashlytics.androidlib/
Assets/Plugins/Android/FirebaseCrashlytics.androidlib.meta
# EDM4U copies the Firebase Android libraries out of the packages on every resolve
Assets/GeneratedLocalRepo/
Assets/GeneratedLocalRepo.meta
# StreamingAssets only holds the generated desktop copy of the Firebase keys so far
Assets/StreamingAssets.meta
*.env
secrets/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Generated by Unity builds (package link.xml merge, performance-test run info)
Assets/packages-merged-link/
Assets/packages-merged-link.meta
Assets/Resources/PerformanceTestRun*
